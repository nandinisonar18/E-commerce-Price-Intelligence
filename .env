# Copy to .env and adjust as needed. Nothing here is a secret credential --
# this app does not require API keys for the recommended sources.

SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///E:/Ecommerce/price_intel/instance/price_intel.db

REQUEST_TIMEOUT=8
MAX_RETRIES=2
BACKOFF_BASE_SECONDS=0.6
MAX_CONCURRENT_SCRAPES=3
SCRAPER_USER_AGENT=PriceIntelBot/1.0 (+https://example.com/bot-info; contact=you@example.com)
RESPECT_ROBOTS_TXT=true

# If a live scrape fails/returns nothing, serve the last good cached
# snapshot for that source instead of failing the whole comparison.
ALLOW_FIXTURE_FALLBACK=true

DEFAULT_INTEREST_RATE_ANNUAL=13.0
DEFAULT_TENURE_MONTHS=12
